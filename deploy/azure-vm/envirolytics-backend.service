[Unit]
Description=Envirolytics FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=envirolytics
Group=envirolytics
WorkingDirectory=/opt/envirolytics/backend
EnvironmentFile=/opt/envirolytics/backend/.env
# ── Single uvicorn process ────────────────────────────────────
# All background tasks (MQTT client, ESPL poller, notification
# scans, DO/chlorine alerts, retention purge, etc.) are launched
# from FastAPI's `startup_event` and must be singleton. Running
# multiple gunicorn workers would fork them N times → duplicate
# emails, duplicate polls, race conditions.
#
# uvicorn + asyncio handles thousands of concurrent requests on
# a single event loop, so throughput is not a concern. If the VM
# is ever moved behind a load balancer with sticky sessions to
# multiple VMs, remove the background tasks from startup_event
# and run them as a *separate* systemd service.
ExecStart=/opt/envirolytics/venv/bin/uvicorn server:app \
    --host 127.0.0.1 --port 8001 \
    --proxy-headers --forwarded-allow-ips "127.0.0.1" \
    --log-level info \
    --access-log --no-use-colors
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/envirolytics/backend.log
StandardError=append:/var/log/envirolytics/backend.log

# Persistent uploads must survive service restarts + git-pull
# redeploys. The workflow's rsync already excludes this dir, so
# photos + certificates + logos + NOC files are safe.
ReadWritePaths=/opt/envirolytics/backend/uploads /var/log/envirolytics

[Install]
WantedBy=multi-user.target
